---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const publications = await getCollection('bitcoin');
const published = publications
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Kurtis Stirling">
  <div class="home-intro">
    <h1>Kurtis Stirling</h1>
    <p>Independent research on Bitcoin, business analysis, and systems thinking.</p>
  </div>

  <h2 class="section-heading">Publications</h2>
  <ul class="publication-list">
    {published.map(pub => (
      <li>
        <h3><a href={`/bitcoin/${pub.id}/`}>{pub.data.title}</a></h3>
        <div class="meta">
          <span>{pub.data.date}</span>
          {pub.data.type && <span> · {pub.data.type}</span>}
        </div>
        <p class="description">{pub.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
